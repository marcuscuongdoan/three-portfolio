# Contact Form Email Configuration
# These environment variables are required for the contact form API to work

# Your Gmail address (or SMTP service email)
EMAIL_USER=your.email@gmail.com

# Gmail App Password (NOT your regular Gmail password)
# Learn how to create an App Password: https://support.google.com/accounts/answer/185833
EMAIL_PASS=your-app-password-here

# (Optional) Recipient email address - defaults to EMAIL_USER
EMAIL_TO=recipient@example.com

# (Optional) Canonical site URL used for metadata/OG tags
NEXT_PUBLIC_SITE_URL=https://your-domain.example.com

# (Optional) Google Analytics 4 measurement ID — defaults to the site's own ID
# in src/config/site.ts; set to an empty value to turn analytics off
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
